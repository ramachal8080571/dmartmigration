								"TableName": {
									"value": {
										"value": "@pipeline().parameters.Tableschema",
										"type": "Expression"
									},
									"type": "String"
								},
								"TableSchema": {
									"value": {
										"value": "@pipeline().parameters.Tablename",
										"type": "Expression"
									},
									"type": "String"
